# left half
ctrl + alt + cmd - left : /opt/homebrew/bin/yabai -m window --grid 1:2:0:0:1:1

# bottom half
ctrl + alt + cmd - down : /opt/homebrew/bin/yabai -m window --grid 2:1:0:1:1:1

# top half
ctrl + alt + cmd - up : /opt/homebrew/bin/yabai -m window --grid 2:1:0:0:1:1

# right half
ctrl + alt + cmd - right : /opt/homebrew/bin/yabai -m window --grid 1:2:1:0:1:1

# maximize
ctrl + alt + cmd - m : /opt/homebrew/bin/yabai -m window --grid 1:1:0:0:1:1

# top left corner
ctrl + shift + alt - left : /opt/homebrew/bin/yabai -m window --grid 2:2:0:0:1:1

# top right corner
ctrl + shift + alt - up : /opt/homebrew/bin/yabai -m window --grid 2:2:1:0:1:1

# bottom left corner
ctrl + shift + alt - down : /opt/homebrew/bin/yabai -m window --grid 2:2:0:1:1:1

# bottom right corner
ctrl + shift + alt - right : /opt/homebrew/bin/yabai -m window --grid 2:2:1:1:1:1

# prev display
ctrl + alt - left : /opt/homebrew/bin/yabai -m window --display prev; /opt/homebrew/bin/yabai -m display --focus prev

# next display
ctrl + alt - right : /opt/homebrew/bin/yabai -m window --display next; /opt/homebrew/bin/yabai -m display --focus next

hyper - 2: open -a "Messages"
hyper - r: open -a "Spotify"
hyper - s: open -a "Slack"
hyper - i: open -a "Cursor"
hyper - p: open -a "1Password"
hyper - space: open -a "Obsidian"
hyper - a: open "https://calendar.google.com/"
hyper - g: open "https://gmail.google.com/"
hyper - l: open "https://github.com/pulls"
hyper - b: code "/Users/danielcorin/dev/thought-eddies"
